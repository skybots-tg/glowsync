<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\glowsync.ico</ApplicationIcon>
    <AssemblyName>GlowSync</AssemblyName>
    <RootNamespace>GlowSync</RootNamespace>
    <Version>1.0.0</Version>
    <Product>GlowSync</Product>
    <Description>Подсветка монитора: синхронизация с экраном, музыка, эффекты</Description>
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <NoWarn>$(NoWarn);MVVMTK0045;CA1416;WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\*.ico" />
    <InternalsVisibleTo Include="GlowSync.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
